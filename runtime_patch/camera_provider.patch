+        private String readSelectedCameraProvider(Context context) {
+            File file = new File(context.getFilesDir(), "phantom_camera_provider.txt");
+            if (file.isFile()) {
+                try (BufferedReader reader = new BufferedReader(
+                        new InputStreamReader(new FileInputStream(file), "UTF-8"))) {
+                    String value = reader.readLine();
+                    return value == null ? "" : value.trim();
+                } catch (Throwable e) {
+                    VLog.w("PHANToM.Camera", "Unable to read provider file: " + e);
+                }
+            }
+            return context.getSharedPreferences("phantom_settings", Context.MODE_PRIVATE)
+                    .getString("camera_package", "");
+        }
+
+        private void applySelectedCameraProvider(Intent intent) {
+            try {
+                Context context = getHostContext();
+                String selected = readSelectedCameraProvider(context);
+                if (TextUtils.isEmpty(selected) || selected.equals(getHostPkg())) {
+                    return;
+                }
+
+                PackageManager pm = VirtualCore.get().getUnHookPackageManager();
+                Intent probe = new Intent(intent);
+                probe.setComponent(null);
+                probe.setPackage(selected);
+                ResolveInfo resolved = pm.resolveActivity(probe, PackageManager.MATCH_DEFAULT_ONLY);
+
+                intent.setComponent(null);
+                intent.setPackage(null);
+
+                if (resolved != null && resolved.activityInfo != null) {
+                    intent.setComponent(new ComponentName(
+                            resolved.activityInfo.packageName, resolved.activityInfo.name));
+                    VLog.i("PHANToM.Camera", "Routing capture intent to declared handler "
+                            + intent.getComponent());
+                } else {
+                    Intent launcher = pm.getLaunchIntentForPackage(selected);
+                    if (launcher == null || launcher.getComponent() == null) {
+                        context.getSharedPreferences("phantom_settings", Context.MODE_PRIVATE)
+                                .edit().remove("camera_package").apply();
+                        try {
+                            new File(context.getFilesDir(), "phantom_camera_provider.txt").delete();
+                        } catch (Throwable ignored) {
+                        }
+                        VLog.w("PHANToM.Camera", "Selected camera has no launchable activity: " + selected);
+                        return;
+                    }
+                    intent.setComponent(launcher.getComponent());
+                    VLog.i("PHANToM.Camera", "Routing capture intent via launcher fallback "
+                            + launcher.getComponent());
+                }
+
+                intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION
+                        | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+                VLog.i("PHANToM.Camera", "Final routed capture intent: " + intent);
+            } catch (Throwable e) {
+                VLog.e("PHANToM.Camera", "Camera provider routing failed: " + e);
+            }
