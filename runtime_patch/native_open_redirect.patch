+// ParcelFileDescriptor and native browser IO use these public libc entry points.
+// Keep Android's original wrappers (including large-file and fortify behavior).
+static bool open_needs_mode(int flags) {
+    if (flags & O_CREAT) return true;
+#ifdef O_TMPFILE
+    if ((flags & O_TMPFILE) == O_TMPFILE) return true;
+#endif
+    return false;
+}
+
+#define DEFINE_OPEN_REDIRECT(name) \
+HOOK_DEF(int, name, const char *pathname, int flags, ...) { \
+    mode_t mode = 0; \
+    if (open_needs_mode(flags)) { \
+        va_list args; va_start(args, flags); mode = va_arg(args, int); va_end(args); \
+    } \
+    int res; \
+    const char *mapped = relocate_path(pathname, &res); \
+    if (res == FORBID) { FREE(mapped, pathname); errno = EACCES; return -1; } \
+    int result = orig_##name(mapped, flags, mode); \
+    int saved_errno = errno; FREE(mapped, pathname); errno = saved_errno; \
+    return result; \
+}
+
+#define DEFINE_OPENAT_REDIRECT(name) \
+HOOK_DEF(int, name, int dirfd, const char *pathname, int flags, ...) { \
+    mode_t mode = 0; \
+    if (open_needs_mode(flags)) { \
+        va_list args; va_start(args, flags); mode = va_arg(args, int); va_end(args); \
+    } \
+    int res; \
+    const char *mapped = relocate_path(pathname, &res); \
+    if (res == FORBID) { FREE(mapped, pathname); errno = EACCES; return -1; } \
+    int result = orig_##name(dirfd, mapped, flags, mode); \
+    int saved_errno = errno; FREE(mapped, pathname); errno = saved_errno; \
+    return result; \
+}
+
+DEFINE_OPEN_REDIRECT(open)
+DEFINE_OPEN_REDIRECT(open64)
+DEFINE_OPENAT_REDIRECT(openat)
+DEFINE_OPENAT_REDIRECT(openat64)
+
+static void hook_open_symbols(void *handle) {
+    const char *names[] = {"open", "open64", "openat", "openat64"};
+    void *replacements[] = {(void *) new_open, (void *) new_open64,
+                            (void *) new_openat, (void *) new_openat64};
+    void **originals[] = {(void **) &orig_open, (void **) &orig_open64,
+                         (void **) &orig_openat, (void **) &orig_openat64};
+    void *seen[4] = {nullptr, nullptr, nullptr, nullptr};
+    int count = 0;
+    for (int i = 0; i < 4; ++i) {
+        void *address = dlsym(handle, names[i]);
+        if (address == nullptr) continue;
+        bool alias = false;
+        for (int j = 0; j < count; ++j) if (seen[j] == address) alias = true;
+        if (alias) continue; // Bionic open64/openat64 can alias their non-64 names.
+        seen[count++] = address;
+        hook_function(address, replacements[i], originals[i]);
+        ALOGI("PHANToM IO %s redirect installed=%d", names[i], *originals[i] != nullptr);
+    }
+}
