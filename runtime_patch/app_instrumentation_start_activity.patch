+    /**
+     * Android 16+ can reach ActivityTaskManager through cached framework singletons.
+     * Intercept guest-to-guest activity starts at the Instrumentation layer first so
+     * virtual activities never escape to the host package.
+     */
+    private boolean startVirtualActivity(Context who, IBinder resultTo, String resultWho,
+                                         Intent intent, int requestCode, Bundle options) {
+        if (intent == null) {
+            return false;
+        }
+        final int userId = VUserHandle.myUserId();
+        try {
+            String resolvedType = intent.resolveTypeIfNeeded(who.getContentResolver());
+            if (resolvedType != null) {
+                intent.setDataAndType(intent.getData(), resolvedType);
+            }
+        } catch (Throwable ignored) {
+        }
+
+        ActivityInfo info = VirtualCore.get().resolveActivityInfo(intent, userId);
+        if (info == null) {
+            return false;
+        }
+
+        int res = VActivityManager.get().startActivity(
+                intent, info, resultTo, options, resultWho, requestCode, userId);
+        if (res != 0 && resultTo != null && requestCode > 0) {
+            VActivityManager.get().sendActivityResult(resultTo, resultWho, requestCode);
+        }
+        VLog.i(TAG, "execStartActivity virtualized: " + intent + " -> " + info.packageName + "/" + info.name);
+        return true;
+    }
