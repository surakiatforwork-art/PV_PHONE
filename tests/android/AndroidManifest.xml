<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.phantom.releaseprobe">
<uses-permission android:name="android.permission.CAMERA"/>
<application android:label="PHANToM Release Probe" android:theme="@android:style/Theme.Material.Light">
<activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
<!-- Disposable test provider exposes only caller identity and the probe's test photo. -->
<provider android:name=".CaptureProvider" android:authorities="com.phantom.releaseprobe.capture" android:exported="true" android:grantUriPermissions="true"/>
</application></manifest>
